{
  "name": "lootopia",
  "version": "1.0.0",
  "description": "Out of Cache souhaite étudier la faisabilité de Lootopia, une plateforme numérique dédiée à la création et à la participation à des chasses au trésor. L’ambition est de proposer une expérience mêlant jeu, géolocalisation, cartographie et gamification.",
  "main": "index.js",
  "private": true,
  "scripts": {
    "test": "npm --prefix backend test && npm --prefix frontend test",
    "test:coverage": "npm --prefix backend run test:coverage && npm --prefix frontend run test:coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,cjs,mjs,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,cjs,mjs,json}\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,cjs,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.json": "prettier --write"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PROJET-ETUDE-LOOTOPIA/Lootopia.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/PROJET-ETUDE-LOOTOPIA/Lootopia/issues"
  },
  "homepage": "https://github.com/PROJET-ETUDE-LOOTOPIA/Lootopia#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "typescript-eslint": "^8.74.0"
  }
}
